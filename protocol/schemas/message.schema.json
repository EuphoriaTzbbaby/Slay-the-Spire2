{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice protocol v1 envelope",
  "type": "object",
  "required": [
    "version",
    "kind"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "request",
        "response",
        "event"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "request"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "method",
        "params"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "id",
        "ok"
      ],
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "event"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "session_id",
        "seq",
        "name",
        "data"
      ]
    }
  ]
}
